{
  "name": "opencode-observer",
  "version": "0.2.0",
  "description": "Visual analysis plugin for OpenCode — isolates image/PDF bytes from the main context by delegating to a vision-capable @observer subagent",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "check:ci": "biome check .",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.29",
    "@opencode/plugin": "^2.0.18",
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "latest",
    "typescript": "^5.0.0"
  },
  "author": "jwcrystal",
  "keywords": ["opencode", "plugin", "observer", "vision", "image-analysis"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jwcrystal/opencode-observer"
  }
}
